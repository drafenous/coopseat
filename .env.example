# Copy to `.env` (local) and set the same keys in Vercel (Production/Preview).

# Public URL of this app. Used for redirects, email links and the Origin check.
APP_URL="http://localhost:3000"

# Supabase project (Project Settings > API keys). Only the server reads these.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# Postgres via the SESSION pooler (port 5432). The Prisma 8 Supabase runtime binds roles
# per session, so the 6543 transaction pooler must not be used.
DATABASE_URL="postgresql://prisma.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Used by `prisma db migrate`. Must be the postgres role (FK and trigger on auth.users).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# `npm run db:sql` needs the postgres role (triggers on auth.users, hook grants).
SQL_ADMIN_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Cloudflare Turnstile. Leave the secret empty locally to skip captcha checks.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TICKET_ENCRYPTION_KEY=""
# Random secret for the HMAC document fingerprint (KYC dedupe). Never rotate without a migration.
DOC_FINGERPRINT_SECRET=""

# KYC provider id (see src/server/identity/providers). "mock" is refused in production
# unless ALLOW_MOCK_KYC=1.
KYC_PROVIDER="mock"
ALLOW_MOCK_KYC=""
MOCK_KYC_SECRET="dev-mock-kyc-secret"

# Only for `npm run supabase:configure` (Management API). Never deploy this.
SUPABASE_ACCESS_TOKEN=""
SUPABASE_PROJECT_REF=""

# Disable Prisma CLI telemetry.
DO_NOT_TRACK="1"
