{
  "name": "@coopseat/ui",
  "version": "0.2.1",
  "private": true,
  "description": "Interface do CoopSeat compartilhada entre o app desktop (Electron) e o site",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./design": "./src/design.ts",
