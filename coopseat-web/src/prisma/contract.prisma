// use prisma-8

types {
  AuthUserId = Uuid
}

enum age_status {
  @@type("pg/text@1")
  UNVERIFIED = "UNVERIFIED"
  PENDING    = "PENDING"
  VERIFIED   = "VERIFIED"
  REJECTED   = "REJECTED"
}

enum verification_status {
  @@type("pg/text@1")
  created  = "created"
  approved = "approved"
  rejected = "rejected"
  review   = "review"
}

enum ticket_kind {
  @@type("pg/text@1")
  desktop_login = "desktop_login"
  link          = "link"
}

namespace public {
  model Profile {
    id                AuthUserId             @id
    user              supabase:auth.AuthUser @relation(fields: [id], references: [id], onDelete: Cascade)
    nickname          String?
    nicknameKey       String?                @unique
    nicknameChangedAt TimestamptzString?
    avatarUrl         String?
    ageStatus         age_status             @default(UNVERIFIED)
    ageVerifiedAt     TimestamptzString?
    termsVersion      String?
    termsAcceptedAt   TimestamptzString?
    createdAt         TimestamptzString      @default(now())
    updatedAt         temporal.updatedAtString()

    @@check(expression: "nickname IS NULL OR nickname ~ '^[A-Za-z0-9_]{3,20}$'", name: "profiles_nickname_format")
    @@check(expression: "\"nicknameKey\" IS NOT DISTINCT FROM lower(nickname)", name: "profiles_nickname_key")
    @@map("profiles")
    @@rls
  }

  policy_select profiles_owner_read {
    target = Profile
    roles  = [authenticated]
    using  = "id = auth.uid()"
  }

  model IdentityVerification {
    id                  Uuid                @id @default(uuid())
    profileId           AuthUserId
    profile             Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
    provider            String
    providerSessionId   String              @unique
    status              verification_status @default(created)
    isAdult             Boolean?
    documentFingerprint String?
    failureReason       String?
    createdAt           TimestamptzString   @default(now())
    completedAt         TimestamptzString?

    @@index([profileId])
    @@index([documentFingerprint], where: "status = 'approved'", unique: true, name: "identity_verifications_fingerprint_approved")
    @@map("identity_verifications")
    @@rls
  }

  model AuthTicket {
    id        String            @id
    kind      ticket_kind
    challenge String?
    payload   String
    expiresAt TimestamptzString
    createdAt TimestamptzString @default(now())

    @@index([expiresAt])
    @@map("auth_tickets")
    @@rls
  }

  model RateLimitHit {
    id        Uuid              @id @default(uuid())
    key       String
    createdAt TimestamptzString @default(now())

    @@index([key, createdAt])
    @@map("rate_limit_hits")
    @@rls
  }

  model RelayPolicy {
    id                   String                     @id @default("global")
    enabled              Boolean                    @default(true)
    membersEnabled       Boolean                    @default(true)
    guestsEnabled        Boolean                    @default(true)
    minAppVersion        String?
    blockedAppVersions   String?
    dailyCredentialQuota Int                        @default(12)
    credentialTtlSeconds Int                        @default(14400)
    maxRelayBitrateKbps  Int                        @default(4000)
    monthlyBudgetGb      Int?                       @default(900)
    note                 String?
    updatedAt            temporal.updatedAtString()

    @@check(expression: "id = 'global'", name: "relay_policy_singleton")
    @@check(expression: "\"dailyCredentialQuota\" >= 0", name: "relay_policy_quota")
    @@check(expression: "\"credentialTtlSeconds\" BETWEEN 60 AND 86400", name: "relay_policy_ttl")
    @@map("relay_policy")
    @@rls
  }

  model RelayUserOverride {
    profileId  AuthUserId         @id
    profile    Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
    blocked    Boolean            @default(false)
    dailyQuota Int?
    reason     String?
    expiresAt  TimestamptzString?
    createdAt  TimestamptzString  @default(now())

    @@map("relay_user_overrides")
    @@rls
  }

  model RelayCredential {
    id         Uuid               @id @default(uuid())
    profileId  AuthUserId
    profile    Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
    username   String
    audience   String
    appVersion String?
    issuedAt   TimestamptzString  @default(now())
    expiresAt  TimestamptzString
    revokedAt  TimestamptzString?

    @@check(expression: "audience IN ('member', 'guest')", name: "relay_credentials_audience")
    @@index([profileId, issuedAt])
    @@index([expiresAt])
    @@map("relay_credentials")
    @@rls
  }

  model RelayUsage {
    month       String            @id
    egressBytes BigIntNumber
    checkedAt   TimestamptzString

    @@check(expression: "month ~ '^[0-9]{4}-[0-9]{2}$'", name: "relay_usage_month")
    @@map("relay_usage")
    @@rls
  }

  model PartyPolicy {
    id                String                     @id @default("global")
    enabled           Boolean                    @default(true)
    maxParticipants   Int                        @default(10)
    maxStreamers      Int                        @default(10)
    sessionMaxHours   Int                        @default(12)
    ownerGraceSeconds Int                        @default(60)
    chatEnabled       Boolean                    @default(true)
    note              String?
    updatedAt         temporal.updatedAtString()

    @@check(expression: "id = 'global'", name: "party_policy_singleton")
    @@check(expression: "\"maxParticipants\" BETWEEN 2 AND 50", name: "party_policy_participants")
    @@check(expression: "\"maxStreamers\" BETWEEN 1 AND 10", name: "party_policy_streamers")
    @@check(expression: "\"sessionMaxHours\" BETWEEN 1 AND 24", name: "party_policy_hours")
    @@check(expression: "\"ownerGraceSeconds\" BETWEEN 10 AND 600", name: "party_policy_grace")
    @@map("party_policy")
    @@rls
  }

  model PartyRoom {
    ownerId          AuthUserId                 @id
    owner            Profile                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    passwordHash     String?
    requireApproval  Boolean                    @default(true)
    whitelistEnabled Boolean                    @default(false)
    defaultLayout    String                     @default("stage")
    maxParticipants  Int?
    createdAt        TimestamptzString          @default(now())
    updatedAt        temporal.updatedAtString()

    @@check(expression: "\"passwordHash\" IS NOT NULL OR \"requireApproval\" OR \"whitelistEnabled\"", name: "party_rooms_protected")
    @@check(expression: "\"defaultLayout\" IN ('stage', 'grid', 'split', 'focus')", name: "party_rooms_layout")
    @@check(expression: "\"maxParticipants\" IS NULL OR \"maxParticipants\" BETWEEN 2 AND 50", name: "party_rooms_participants")
    @@map("party_rooms")
    @@rls
  }

  model PartyRoomWhitelist {
    id        Uuid              @id @default(uuid())
    roomId    AuthUserId
    room      PartyRoom         @relation(fields: [roomId], references: [ownerId], onDelete: Cascade)
    profileId AuthUserId
    profile   Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
    canStream Boolean           @default(false)
    createdAt TimestamptzString @default(now())

    @@unique([roomId, profileId])
    @@map("party_room_whitelist")
    @@rls
  }

  model PartyRoomModerator {
    id                Uuid              @id @default(uuid())
    roomId            AuthUserId
    room              PartyRoom         @relation(fields: [roomId], references: [ownerId], onDelete: Cascade)
    profileId         AuthUserId
    profile           Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
    canKick           Boolean           @default(true)
    canBan            Boolean           @default(false)
    canStopStreams    Boolean           @default(true)
    canApprove        Boolean           @default(true)
    canGrantStream    Boolean           @default(false)
    canDeleteMessages Boolean           @default(true)
    createdAt         TimestamptzString @default(now())

    @@unique([roomId, profileId])
    @@map("party_room_moderators")
    @@rls
  }

  model PartyRoomBan {
    id        Uuid               @id @default(uuid())
    roomId    AuthUserId
    room      PartyRoom          @relation(fields: [roomId], references: [ownerId], onDelete: Cascade)
    profileId AuthUserId
    profile   Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
    reason    String?
    bannedBy  Uuid
    expiresAt TimestamptzString?
    createdAt TimestamptzString  @default(now())

    @@unique([roomId, profileId])
    @@check(expression: "reason IS NULL OR length(reason) <= 300", name: "party_room_bans_reason")
    @@map("party_room_bans")
    @@rls
  }

  model PartySession {
    id        Uuid               @id @default(uuid())
    roomId    AuthUserId
    room      PartyRoom          @relation(fields: [roomId], references: [ownerId], onDelete: Cascade)
    startedAt TimestamptzString  @default(now())
    endedAt   TimestamptzString?
    endReason String?

    @@index([roomId], where: "\"endedAt\" IS NULL", unique: true, name: "party_sessions_one_active")
    @@index([startedAt])
    @@check(expression: "\"endReason\" IS NULL OR \"endReason\" IN ('owner_ended', 'owner_timeout', 'max_duration', 'sanction', 'operator')", name: "party_sessions_end_reason")
    @@map("party_sessions")
    @@rls
  }

  model PartySessionParticipant {
    id        Uuid               @id @default(uuid())
    sessionId Uuid
    session   PartySession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
    profileId AuthUserId
    profile   Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
    joinedAt  TimestamptzString  @default(now())
    leftAt    TimestamptzString?
    removal   String?
    removedBy Uuid?

    @@index([sessionId])
    @@index([profileId])
    @@check(expression: "removal IS NULL OR removal IN ('kick', 'ban')", name: "party_session_participants_removal")
    @@map("party_session_participants")
    @@rls
  }

  model PartyModerationEvent {
    id        Uuid              @id @default(uuid())
    roomId    AuthUserId
    room      PartyRoom         @relation(fields: [roomId], references: [ownerId], onDelete: Cascade)
    sessionId Uuid?
    actorId   Uuid
    targetId  Uuid?
    action    String
    detail    String?
    createdAt TimestamptzString @default(now())

    @@index([roomId, createdAt])
    @@map("party_moderation_events")
    @@rls
  }

  model PlatformSanction {
    id        Uuid               @id @default(uuid())
    profileId AuthUserId
    profile   Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
    scope     String
    reason    String?
    expiresAt TimestamptzString?
    createdBy String?
    createdAt TimestamptzString  @default(now())
    revokedAt TimestamptzString?

    @@index([profileId])
    @@check(expression: "scope IN ('platform', 'party_host', 'party_stream', 'party_join', 'party_chat')", name: "platform_sanctions_scope")
    @@map("platform_sanctions")
    @@rls
  }
}
