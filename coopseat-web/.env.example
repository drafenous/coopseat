# Copy to `.env` (local) and set the same keys in Vercel (Production/Preview).

# Public URL of this app. Used for redirects, email links and the Origin check.
APP_URL="http://localhost:3000"

# Supabase project (Project Settings > API keys). Only the server reads these.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

# Postgres via the SESSION pooler (port 5432). The Prisma 8 Supabase runtime binds roles
# per session, so the 6543 transaction pooler must not be used.
DATABASE_URL="postgresql://prisma.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Used by `prisma db migrate`. Must be the postgres role (FK and trigger on auth.users).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# `npm run db:sql` needs the postgres role (triggers on auth.users, hook grants).
SQL_ADMIN_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Cloudflare Turnstile. Leave the secret empty locally to skip captcha checks.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Google Analytics 4 measurement id (G-...). Leave empty to disable analytics and the cookie banner.
NEXT_PUBLIC_GA_ID="G-35K2LL00KH"
# Measurement Protocol secret (GA > Admin > Data streams > Measurement Protocol API secrets).
# Server-only; enables the opt-in desktop telemetry relayed by /api/telemetry.
GA_API_SECRET=""

# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TICKET_ENCRYPTION_KEY=""
# Random secret for the HMAC document fingerprint (KYC dedupe). Never rotate without a migration.
DOC_FINGERPRINT_SECRET=""

# KYC provider id: "mock" or "didit" (see src/server/identity/providers). "mock" is refused in
# production unless ALLOW_MOCK_KYC=1.
KYC_PROVIDER="mock"
ALLOW_MOCK_KYC=""
MOCK_KYC_SECRET="dev-mock-kyc-secret"

# Didit (business.didit.me), required when KYC_PROVIDER="didit". Server-only.
# API & Webhooks: copy the API key and add a destination <APP_URL>/api/identity/webhooks/didit
# (webhook version v3, event status.updated); its signing secret goes in DIDIT_WEBHOOK_SECRET.
# The workflow must include ID verification (passive liveness and face match recommended).
DIDIT_API_KEY=""
DIDIT_WORKFLOW_ID=""
DIDIT_WEBHOOK_SECRET=""

# Resend (resend.com > API Keys, "Sending access" scoped to coopseat.com). Server-only.
# The BFF sends transactional e-mail with it, and `npm run supabase:configure` sets it as the
# Supabase Auth SMTP password (smtp.resend.com), so auth e-mails also leave from no-reply@coopseat.com.
RESEND_API_KEY=""
# Optional sender override; must be on a domain verified in Resend.
EMAIL_FROM="CoopSeat <no-reply@coopseat.com>"

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type "Web").
# Server-only. The BFF runs the Google sign-in (so Google shows our domain) and hands the id_token to Supabase;
# `npm run supabase:configure` registers the same client id in Supabase Auth so it accepts those tokens.
# Authorized redirect URIs: <APP_URL>/api/auth/callback (e.g. https://coopseat.com/api/auth/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudflare Realtime TURN (watch party): Dashboard > Realtime > TURN Server. Server-only.
CLOUDFLARE_TURN_KEY_ID=""
CLOUDFLARE_TURN_API_TOKEN=""
# Monthly relay budget (relay_policy."monthlyBudgetGb"): reads TURN egress from the GraphQL Analytics API.
# Account ID: Dashboard > account home (right sidebar). Token: My Profile > API Tokens, permission
# "Account > Account Analytics > Read". In production, a missing token blocks the relay while a budget is set.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ANALYTICS_API_TOKEN=""

# Gaming-Party room tokens (Ed25519). The BFF signs with the private key; coopseat-signal only gets the
# public key. Either a PEM (newlines escaped as \n) or just its base64 body on one line. Generate a pair:
#   node -e "const {privateKey:k,publicKey:p}=require('crypto').generateKeyPairSync('ed25519',{privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log(JSON.stringify(k));console.log(JSON.stringify(p))"
PARTY_TOKEN_PRIVATE_KEY=""
PARTY_TOKEN_PUBLIC_KEY=""
# Base https URL of the coopseat-signal Worker (also allowed in the /party CSP). Locally, `npm run dev:signal`
# serves it at http://localhost:8787.
PARTY_SIGNAL_URL="https://sinal.coopseat.com"
# Shared HMAC secret between this app and coopseat-signal (same value as the Worker secret of the same name).
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PARTY_SIGNAL_SECRET=""

# GitHub fine-grained token for /download (github.com/settings/personal-access-tokens), server-only.
# Repository access: only the desktop repo; permission "Contents: Read-only". /download redirects
# visitors to the "*-Setup.exe" asset of that repo's latest published release.
GITHUB_RELEASES_TOKEN=""
GITHUB_RELEASES_REPO="drafenous/coopseat"

# Only for `npm run supabase:configure` (Management API). Never deploy this.
SUPABASE_ACCESS_TOKEN=""
SUPABASE_PROJECT_REF=""

# Disable Prisma CLI telemetry.
DO_NOT_TRACK="1"
