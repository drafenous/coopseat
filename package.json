{
  "name": "coopseat-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "coopseat",
    "coopseat-web"
  ],
  "scripts": {
    "dev:web": "npm run dev -w coopseat-web",
    "dev:desktop": "npm run dev -w coopseat",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  }
}
