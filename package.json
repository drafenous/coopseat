{
  "name": "coopseat-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "coopseat",
    "coopseat-web",
    "coopseat-signal"
  ],
  "scripts": {
    "dev:web": "npm run dev -w coopseat-web",
    "dev:signal": "npm run dev -w coopseat-signal -- --env dev",
    "deploy:signal": "npm run deploy -w coopseat-signal",
    "dev:desktop": "npm run dev -w coopseat",
    "build:web": "npm run build -w coopseat-web",
    "build:desktop": "npm run build -w coopseat",
    "start:web": "npm run start -w coopseat-web",
    "start:desktop": "npm run start -w coopseat",
    "dist:desktop": "npm run dist -w coopseat",
    "dist:desktop:portable": "npm run dist:portable -w coopseat",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
